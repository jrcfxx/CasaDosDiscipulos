# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=CasaDosDiscipulos
DB_PORT=3306

# API
PORT=3001
JWT_SECRET=altere-para-uma-chave-segura-em-producao

# WhatsApp (Evolution API) - opcional
# Se não configurado, as notificações por WhatsApp ficam desativadas
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=casadosdiscipulos
EVOLUTION_API_KEY=change-me

# Job semanal de módulos pendentes (cron: segundas às 9h)
# Formato cron: minuto hora dia-mês mês dia-semana
WHATSAPP_CRON_MODULOS=0 9 * * 1
