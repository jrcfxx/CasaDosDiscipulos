            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quiz/1/respostas/usuario?usuarioId=3",
              "host": ["{{baseUrl}}"],
              "path": ["quiz", "1", "respostas", "usuario"],
              "query": [
