          "name": "Submeter Respostas de Quiz",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": 3,\n  \"respostas\": [\n    {\n      \"id_questao\": 1,\n      \"resposta\": \"a\"\n    },\n    {\n      \"id_questao\": 2,\n      \"resposta\": \"v\"\n    },\n    {\n      \"id_questao\": 3,\n      \"resposta\": \"Minha resposta discursiva completa sobre o tema abordado na questão.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
