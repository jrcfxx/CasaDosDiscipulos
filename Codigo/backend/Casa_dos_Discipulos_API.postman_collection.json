            },
            "url": {
              "raw": "{{baseUrl}}/quiz/1/responder",
              "host": ["{{baseUrl}}"],
              "path": ["quiz", "1", "responder"]
            },
            "description": "Submete respostas de um quiz completo. O sistema:\n- Corrige automaticamente (exceto discursivas)\n- Atualiza pontuação do usuário\n- Marca módulo como concluído"
          }
        },
