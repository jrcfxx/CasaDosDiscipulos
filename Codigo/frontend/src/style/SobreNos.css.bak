/**
 * SobreNos Styles
 * Página sobre a Casa dos Discípulos
 */

/* ==================== CONTAINER PRINCIPAL ==================== */

.sobre-nos-page {
  min-height: 100vh;
  background-color: #000;
  padding-top: 90px;
}

.sobre-nos-content {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

/* ==================== TÍTULO ==================== */

.sobre-nos__title {
  font-size: 3rem;
  font-weight: 700;
  color: #fff;
  text-align: center;
  margin: 0 0 3rem 0;
  letter-spacing: -0.5px;
}

/* ==================== IMAGENS ==================== */

.sobre-nos__images {
  display: flex;
  flex-direction: column;
  gap: 3rem;
  max-width: 1000px;
  margin: 0 auto;
}

.sobre-nos__section {
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  transition: transform 0.3s ease;
}

.sobre-nos__section:hover {
  transform: translateY(-4px);
}

.sobre-nos__image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

/* ==================== RESPONSIVE ==================== */

@media (max-width: 768px) {
  .sobre-nos-page {
    padding-top: 80px;
  }

  .sobre-nos-content {
    padding: 2rem 1rem;
  }

  .sobre-nos__title {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .sobre-nos__images {
    gap: 2rem;
  }
}

@media (max-width: 480px) {
  .sobre-nos__title {
    font-size: 1.75rem;
  }

  .sobre-nos__images {
    gap: 1.5rem;
  }
}
/* CONTEÚDO */
.content{
  width:min(1180px,92vw);
  margin:22px auto 36px;
  display:flex; flex-direction:column; gap:28px;
 top: 60 px;
}

/* Blocos com imagem de fundo */
.card-img{
  position:relative;
  border-radius:var(--radius);
  overflow:hidden;
  background-size:cover;
  background-position:center;
  box-shadow:var(--shadow);
  padding-top: 150px;

}
.card-img .overlay{
  position:absolute; inset:0;
  background:radial-gradient(120% 120% at 70% 10%, rgba(0,0,0,.15), rgba(0,0,0,.55) 60%, rgba(0,0,0,.75) 100%);
}

/* HERO */
.hero{ height:420px; }
.hero-content{
  position:absolute; inset:0;
  display:flex; flex-direction:column; gap:16px;
  justify-content:center; align-items:center;
  text-align:center; padding:0 24px;
  padding-top: 50 px;
}



.brand-band {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
padding-top: 50 px;
  margin: 0;
  position: relative;
  z-index: 2;
}

.brand-logo {
  width: clamp(220px, 26vw, 360px);
  height: auto;
  display: block;
  object-fit: contain;
  filter: drop-shadow(0 8px 24px rgba(0,0,0,.45));
}



.imagem {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20px auto;
  width: 100%;
  max-width: 1100px;
  border-radius: 20px;
  position: relative;
  z-index: 1;
  overflow: visible;
  padding-top: 50 px;
}

/* regras para imagens hero - garantem que não fiquem tampadas e mantenham proporção */
.hero-image {
  display: block;
  width: 70%;
  max-width: 900px;
  height: auto;
  object-fit: cover;
  border-radius: 20px;
  position: relative;
  z-index: 0;

}



.sobre img {

  border-radius: 15px;
  margin-right: 40px;
}

.sobre-text {
   width: 100%;
  text-align: center;
}






@media (max-width:820px){
  .header-icone img{ width:64px; }
  .header-links{ gap:24px; flex-wrap:wrap; }
  .hero{ height:340px; }
  .grid-2 .card-img{ height:180px; }
  .banner{ height:240px; }
}
/* Centralizar título dos cards */
.grid-2 .card-title{
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  z-index: 1;
  margin: 0;
  width: calc(100% - 32px);
  text-align: center;
  font-weight: 400;
  font-size: clamp(22px, 2.6vw, 34px);
  letter-spacing: .01em;
  color: #fff;
  text-shadow: 0 4px 14px rgba(0,0,0,.5);
}

@media (max-width: 820px){
  .grid-2 .card-title{
    bottom: 14px;
    font-size: clamp(20px, 4.5vw, 28px);
  }
}

.hero-text{
  margin: 0 0 1em; /* Aumento de Espaço */
}
.hero .btn{
  margin-top: 0;
}
/* FONTE Montserrat */
.logo h1,
.hero-text,
.card-title,
.banner-text h2,



.home .content{
 padding-top:460px;
}

.hero.card-img{
  position: relative;
  z-index: 1;
}


