/** Retorna os campos configurados para um nome de área */
function getCamposPorArea(nomeArea) {
	const nomeNorm = nomeArea.toLowerCase().trim();
	const config = MINISTERIO_CAMPOS.find((m) => m.palavrasChave.some((p) => nomeNorm.includes(p.toLowerCase())));
	return config?.campos ?? [{
		chave: "observacoes",
		label: "Observações",
		tipo: "textarea"
	}];
