# Casa dos Discípulos - Variáveis para deploy
# Copie: cp .env.example .env

# ========== Banco de Dados ==========
DB_USER=casadiscipulos
DB_PASSWORD=ALTERE_SENHA_SEGURA
DB_NAME=CasaDosDiscipulos

# ========== JWT ==========
JWT_SECRET=ALTERE_PARA_CHAVE_MUITO_SEGURA_32_CARACTERES

# ========== Frontend (URL da API - use /api para mesmo domínio) ==========
REACT_APP_API_URL=/api

# ========== Evolution API (WhatsApp) ==========
EVOLUTION_API_KEY=sua-chave-segura-evolution
EVOLUTION_INSTANCE_NAME=casadosdiscipulos
# URL pública da Evolution (para webhooks - opcional)
EVOLUTION_SERVER_URL=
