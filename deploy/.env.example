# Casa dos Discípulos — variáveis de deploy
# Copie: cp .env.example .env
# Gere segredos: openssl rand -hex 32

# ========== Banco de Dados ==========
DB_USER=casadiscipulos
DB_PASSWORD=ALTERE_SENHA_SEGURA
DB_NAME=CasaDosDiscipulos

# ========== JWT (mínimo 32 caracteres) ==========
JWT_SECRET=ALTERE_PARA_CHAVE_MUITO_SEGURA_32_CARACTERES

# ========== Domínio / CORS ==========
# Domínio público (usado por ./deploy.sh --enable-ssl)
DOMAIN=app.casadosdiscipulos.org
# Origens permitidas (separadas por vírgula). Em HTTPS:
# CORS_ORIGIN=https://app.casadosdiscipulos.org
# Enquanto só tiver IP:
CORS_ORIGIN=http://SEU_IP_DO_SERVIDOR

# ========== Frontend (mesmo domínio → /api) ==========
REACT_APP_API_URL=/api

# ========== Evolution API (WhatsApp) ==========
EVOLUTION_API_KEY=sua-chave-segura-evolution
EVOLUTION_INSTANCE_NAME=casadosdiscipulos
# URL vista pelo painel Evolution (túnel SSH: http://127.0.0.1:8080)
EVOLUTION_SERVER_URL=http://127.0.0.1:8080
